# Site configuration for JACI / INPE
#
# This file contains only machine-specific settings. The build scripts should
# remain generic and must not hard-code hostnames, queues or Spack paths.

SITE_ID="jaci"
SITE_DESCRIPTION="JACI / INPE Cray site configuration for MONAN-bundle based on MPAS-bundle"

# Keep this disabled until the final login-node names are confirmed.
# When enabled, SITE_HOST_REGEX is checked against $(hostname -f) and $(hostname).
HOST_CHECK_ENABLED="0"
SITE_HOST_REGEX="^jaci"

# Institutional/group Spack-Stack installation.
# The expected policy is: one shared Spack-Stack per group, not one Spack tree per user.
SPACK_STACK_ROOT="/mnt/beegfs/das.group/spack-envs/mpas-bundle"
SPACK_ACTIVATE_SCRIPT="${SPACK_STACK_ROOT}/start_spack_bundle.sh"

# Default compiler/toolchain label used by the bundle scripts.
# Adjust this after the final Cray programming environment is validated.
COMPILER_LABEL="gnu"

# JACI is a Cray system using PBS. EGEON must be represented by a separate
# site file, for example config/sites/egeon.env, with SCHEDULER="slurm".
DEFAULT_MODE="local"
SCHEDULER="pbs"

# Build workspace. Users may override this at runtime with MONAN_BUNDLE_BUILD_ROOT.
BUILD_ROOT="${MONAN_BUNDLE_BUILD_ROOT:-${SCRIPT_DIR}/builds}"

# CMake defaults.
CMAKE_BUILD_TYPE="Release"
MPAS_BUNDLE_NOREMOTE="ON"
CMAKE_VERBOSE_MAKEFILE="ON"

# PBS defaults for JACI. These values are intentionally conservative and should
# be adjusted after confirming the production queues and resource policy.
PBS_QUEUE="workq"
PBS_PROJECT=""
PBS_BUILD_JOB_NAME="monan_build"
PBS_CTEST_JOB_NAME="monan_ctest"
PBS_BUILD_SELECT="1:ncpus=64"
PBS_CTEST_SELECT="1:ncpus=64"
PBS_BUILD_WALLTIME="02:00:00"
PBS_CTEST_WALLTIME="01:00:00"
